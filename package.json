{
  "name": "flux-browser",
  "productName": "Flux",
  "version": "1.1.0",
  "description": "Comet: a fully custom, modular liquid-glass desktop browser for macOS. (productName stays Flux: it names the keychain entry.)",
  "private": true,
  "type": "commonjs",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/setup-electron.mjs && electron .",
    "dev": "node scripts/setup-electron.mjs && electron . --dev",
    "postinstall": "node scripts/setup-electron.mjs || true",
    "fix-electron": "node scripts/setup-electron.mjs",
    "install-app": "bash scripts/install-app.sh",
    "dist": "bash scripts/make-dmg.sh"
  },
  "author": "Landon (whoslandon)",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  }
}
